{
  "name": "acm-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop ACM training assistant.",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:main && npm run rebuild:electron && electron .",
    "build:main": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && node -e \"const fs=require('fs'); const js='dist-electron/preload/preload.js'; const cjs='dist-electron/preload/preload.cjs'; if (fs.existsSync(cjs)) fs.rmSync(cjs); fs.renameSync(js, cjs);\"",
    "build": "tsc --noEmit && vite build && npm run build:main",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "test": "npm run rebuild:node && vitest --passWithNoTests",
    "start": "npm run build:main && npm run rebuild:electron && electron .",
    "package": "npm run build && npm run rebuild:electron && electron-builder"
  },
  "build": {
    "appId": "local.acm-trainer",
    "productName": "ACM Trainer",
    "asar": false,
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14",
    "wait-on": "^9.0.3"
  }
}
